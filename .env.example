# 讯飞开放平台 API 密钥
# 同一个应用下开通多个能力（ASR 转写 / 语音评测 / 语音分析），三者复用同一套凭证；
# 服务器靠不同接口地址（host + path）区分服务，因此 app_id / api_key / api_secret 可相同。
IFLYTEK_APP_ID=your_app_id_here          # 应用 ID（Ifasr_llm 上传 / ISE 流式版使用）
IFLYTEK_API_KEY=your_api_key_here        # APIKey（Ifasr_llm 的 accessKeyId / ISE / VAA 鉴权）
IFLYTEK_API_SECRET=your_api_secret_here  # APISecret（签名密钥，各接口通用）

# Model API Gateway 密钥（默认未启用）
AI_GATEWAY_API_KEY=your_gateway_key_here
